{
    "workbench.colorTheme": "Catppuccin Mocha",
    "catppuccin.accentColor": "blue",
    "editor.allowVariableFontsInAccessibilityMode": true,
    "editor.fontFamily": "JetBrainsMono Nerd Font, Monaco, 'Courier New', monospace",
    "editor.codeLensFontFamily": "JetBrainsMono Nerd Font",
    "workbench.tabs.experimental.fontFamily": "JetBrainsMono Nerd Font",
    "workbench.statusBar.experimental.fontFamily": "JetBrainsMono Nerd Font",
    "workbench.sideBar.experimental.fontFamily": "JetBrainsMono Nerd Font",
    "workbench.experimental.fontFamily": "JetBrainsMono Nerd Font",
    "workbench.bottomPane.experimental.fontFamily": "JetBrainsMono Nerd Font",
    "editor.inlayHints.fontFamily": "JetBrainsMono Nerd Font",
    "editor.inlineSuggest.fontFamily": "JetBrainsMono Nerd Font",
    "workbench.activityBar.experimental.fontFamily": "JetBrainsMono Nerd Font",
    "chat.fontFamily": "JetBrainsMono Nerd Font",
    "debug.console.fontFamily": "JetBrainsMono Nerd Font",
    "terminal.integrated.fontFamily": "JetBrainsMono Nerd Font",
    "notebook.output.fontFamily": "JetBrainsMono Nerd Font",
    "errorLens.fontFamily": "JetBrainsMono Nerd Font",
    "markdown.preview.fontFamily": "JetBrainsMono Nerd Font, BlinkMacSystemFont, 'Segoe WPC', 'Segoe UI', system-ui, 'Ubuntu', 'Droid Sans', sans-serif",
    "terminal.integrated.fontLigatures.enabled": true,
    "git.enableSmartCommit": true,
    "git.confirmSync": false
